# ============================================================
# Ankara GOAT v0.3.0
# Copiá este archivo a .env para desarrollo local.
# NUNCA subas .env ni secretos reales a Git.
# ============================================================
PORT=3000
NODE_ENV=development
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Roles iniciales por email. Separar varios con coma.
ADMIN_EMAILS=admin@ankaragoat.local
MODERATOR_EMAILS=moderador@ankaragoat.local

# Sólo desarrollo. En producción Railway ejecuta npm run migrate
# como pre-deploy mediante railway.json.
AUTO_MIGRATE=true

# ------------------------------------------------------------
# MySQL
# ------------------------------------------------------------
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=ankara_goat
# En Railway es preferible usar una Reference Variable:
# DATABASE_URL=${{MySQL.MYSQL_URL}}
# DATABASE_URL=mysql://user:password@host:3306/database

# Pool por réplica Node. Recordá: conexiones aprox. = réplicas * DB_POOL_MAX.
DB_POOL_MAX=12
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# ------------------------------------------------------------
# Redis + Socket.IO + BullMQ
# ------------------------------------------------------------
# En Railway usar Reference Variable:
# REDIS_URL=${{Redis.REDIS_URL}}
# REDIS_URL=redis://default:password@host:6379
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000

# ------------------------------------------------------------
# Cloudflare R2 - escudos
# ------------------------------------------------------------
# En producción usar r2. local sólo es para desarrollo.
MEDIA_PROVIDER=local
R2_ACCOUNT_ID=eaaca26fb1d895b5be70c37c0cd4c8f6
R2_ACCESS_KEY_ID=178232f415e11dc05c369aec256eb06a
R2_SECRET_ACCESS_KEY=56664dba4cfb1611d1143c1e69d8f08696331954c8d781a6f228e50b554408ef
R2_BUCKET=ankara-goat-media
# Dominio público del bucket, sin slash final. Ej: https://media.ankaragoat.com
R2_PUBLIC_BASE_URL=https://media.ankaragoat.fun
# Opcional. Si se omite se construye con R2_ACCOUNT_ID:
# R2_ENDPOINT=https://eaaca26fb1d895b5be70c37c0cd4c8f6.r2.cloudflarestorage.com

# ------------------------------------------------------------
# Moderación
# ------------------------------------------------------------
# Palabras/frases adicionales bloqueadas por tu propia política,
# separadas con coma. Es una primera barrera; no sustituye moderadores.
MODERATION_BLOCKLIST=

# ------------------------------------------------------------
# Pruebas de carga - USAR SÓLO EN DEVELOPMENT/STAGING
# ------------------------------------------------------------
LOAD_TEST_CONFIRM=NO
LOAD_TEST_TARGET=http://localhost:3000
